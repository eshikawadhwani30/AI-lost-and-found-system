# ========================================================
# Server Configuration
# ========================================================
PORT=5000
NODE_ENV=development

# ========================================================
# Database Configuration
# Local MongoDB connection or MongoDB Atlas URI:
# Local: mongodb://127.0.0.1:27017/lost_and_found_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lost_and_found_db?retryWrites=true&w=majority
# ========================================================
MONGO_URI=mongodb://127.0.0.1:27017/lost_and_found_db

# ========================================================
# Frontend Client URL (for CORS)
# ========================================================
CLIENT_URL=http://localhost:5173

# ========================================================
# JWT Authentication Secrets (used in Phase 3)
# ========================================================
JWT_SECRET=super_secret_jwt_key_lost_and_found_btech_project_2024
JWT_EXPIRES_IN=7d

# ========================================================
# Google Gemini API Key (used in Phase 9 for AI matching)
# Get your free API key at: https://aistudio.google.com/
# ========================================================
GEMINI_API_KEY=your_google_gemini_api_key_here

# ========================================================
# File Upload Configuration
# ========================================================
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880 # 5 MB in bytes
